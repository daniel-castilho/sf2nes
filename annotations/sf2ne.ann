# ============================================================================================================
# BANCOS DE ESTADOS DOS LUTADORES (formato em docs/ARQUITETURA.md, secao 4.2)
# statebank <banco> frames=<banco dos frames> from=<inicio> to=<fim>
# Completa, pela estrutura dos registros, os ponteiros dos estados que nenhum trace visitou.
# ============================================================================================================
statebank 01 frames=00 from=A0B0 to=B1C6

# ============================================================================================================
# PONTEIROS CONFIRMADOS A MAO (o trace nao passou por estes trechos; achados com tools/ptr_candidates.py)
# ============================================================================================================
# Candidatos do ptr_candidates.py ja revisados e que NAO sao ponteiros (sao coordenadas, rolagem ou enderecos do PPU):
#   37:EF58/EF5D ($E0F8 -> ScrollX/ScrollY)   37:F576/F57A ($FF10)          3B:E3AE/E3A9 ($8000 -> camera)
#   3B:E5D7/E5DC ($FF32)                      3B:E622/E61D ($C6C5 -> HUD)   3B:EC10/EC14 ($90E0 -> posicao x,y)
#   3B:ECAB/ECB0 e 3B:ECCF/ECD4 (endereco de nametable)   3B:F784/F788 ($805C -> posicao x,y)   3F:F85C/F860 ($FFFF)
# roteiro de IA do Ryu passado em A/Y para AiStartScript
ptr 00:9036 lo 00:8F16
ptr 00:9038 hi 00:8F16
# mesmo ponteiro de 3B:E188, noutro caminho
ptr 3B:E158 lo 3C:83B6
ptr 3B:E15C hi 3C:83B6
# metasprite de texto de fim de round (ramo nunca executado nos traces), irmao de 3B:F88F -> 20:84A1
ptr 3B:F8A2 lo 20:848B
ptr 3B:F8A6 hi 20:848B

# ============================================================================================================
# CORRECAO OPCIONAL: travamento no soft reset  (make fixed)   — detalhes em docs/BUGS.md
# O codigo de RESET so existe no banco $3F, mas o MMC5 nao e' reiniciado pelo botao RESET do console: se o reset
# acontece com o banco $37 ou $3B em $E000, o vetor aponta para $FF9F cheio de $FF e o jogo trava.
# A correcao poe o MESMO trecho de 13 bytes no espaco livre $FC6D dos tres bancos e aponta o vetor de RESET
# para ele: ele mapeia o banco $3F e pula para o reset original.
alt FIX_SOFT_RESET 37:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS                         ; desliga o IRQ de scanline que pode ter ficado armado
|    lda #$BF
|    sta MMC5_PRG_E000                           ; banco $3F em $E000 (a proxima instrucao ja vem dele)
|    jmp $FF9F                                   ; Reset original (so existe no banco $3F)
alt FIX_SOFT_RESET 3B:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS
|    lda #$BF
|    sta MMC5_PRG_E000
|    jmp $FF9F
alt FIX_SOFT_RESET 3F:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS
|    lda #$BF
|    sta MMC5_PRG_E000
|    jmp $FF9F
alt FIX_SOFT_RESET 37:FFFC 2
|    .word ResetStub
alt FIX_SOFT_RESET 3B:FFFC 2
|    .word ResetStub
alt FIX_SOFT_RESET 3F:FFFC 2
|    .word ResetStub

# ============================================================================================================
# AJUSTE EXPERIMENTAL: golpe forte dispara UMA vez   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D FIX_HEAVY_ONCE")
# No original, segurar A/B emite o golpe forte a cada quadro do 7o ao 20o e outra vez ao soltar (ver docs/BUGS.md).
# Aqui ele e' emitido so no quadro em que o contador chega a 7, e soltar depois disso nao emite nada.
# Muda a jogabilidade: teste antes de adotar.
# NOTA: os 4 ancoras abaixo caem dentro do bloco reescrito pelo FIX_EDGE_ATTACK (E99A-E9FB): sao emitidos
# aninhados no ramo .else dele, entao continuam funcionando sozinhos como antes. Com FIX_EDGE_ATTACK ligado
# sao subsumidos: a nao-repeticao do forte passa a vir do marcador $FF do EdgeMarkHold. Combinar os dois e' inofensivo.
alt FIX_HEAVY_ONCE 3F:E9AD 2
|    bne BtnBCheck                               ; era bcc: so quando o contador e' exatamente 7
alt FIX_HEAVY_ONCE 3F:E9C6 2
|    lda #$FF                                    ; era lda #$01: soltar depois de 7 quadros nao repete o golpe
alt FIX_HEAVY_ONCE 3F:E9DE 2
|    bne BtnNone
alt FIX_HEAVY_ONCE 3F:E9F7 2
|    lda #$FF

# ============================================================================================================
# AJUSTE: golpe na borda de subida + promocao fraco->forte   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D FIX_EDGE_ATTACK")
# Problema original (docs/BUGS.md item 2): o golpe so sai quando o botao e' SOLTO (fraco) ou se repete
# do 7o ao 20o quadro (forte) — todo golpe sai atrasado e o forte "metralha".
# Aqui: o FRACO sai no quadro em que o botao e' apertado (borda de subida: contador==1); segurando,
# o contador segue contando e no 7o quadro o FORTE assume (promocao — o motor ja' decide se o estado
# do lutador aceita cancelar a animacao do fraco). Soltar antes de 7 quadros nao emite nada (o fraco
# ja' saiu no aperto); soltar entre 7 e 20 emite o forte uma ultima vez, como no original.
#
# Anti-repeticao (o coracao do ajuste): o marcador do InputDispatch (F6C9) era cego — gravava $15 nos
# DOIS contadores em qualquer despacho de botao, inclusive fraco, o que mataria a promocao. Passa a
# ser seletivo (EdgeMarkHold, no espaco livre): forte despachado -> $FF nos dois contadores (no caminho
# segurado o iny faz wrap a 0 e desarma; na soltura o cpy #$15 ignora); fraco despachado -> $01 no
# contador do proprio botao so' (conta dali em diante; o outro botao nao e' afetado).
#
# A secao A+B do InputButtons (E99A-E9FB, $62 = 98 bytes) e' reescrita por inteiro num bloco so'; os 4 ancoras
# do FIX_HEAVY_ONCE caem dentro dele (ver nota ali em cima). O emitidor fraco/forte tail-calla
# InputSetAttack (sta InputAttack,x; rts) igual ao original, pulando o processamento do outro botao.
# Diferencas conscientes vs original: segurando alem de 20 quadros o forte continua armado (o original
# desistia — aqui ele sai quando o estado permitir, o que e' o comportamento pedido); apos ~256 quadros
# segurando o contador da wrap e o botao volta a edgear (fraco) — caso extreme, original tambem tinha
# um wrap ali (o beq de $FF->0).
alt FIX_EDGE_ATTACK 3F:E99A 62
|InputButtons:
|    lda JoyState,x                              ; botao A (bit 7): segurado?
|    bpl EdgeARel                                ; soltou -> logica de soltura
|    ldy BtnAHold,x
|    iny
|    beq EdgeBBtn                                ; wrap $FF->0 (marcador de forte): ignora
|    sty BtnAHold,x
|    cpy #$02                                     ; borda de subida: contador==1
|    bcc EdgeAWeak                                ; -> soco fraco AGORA
|    cpy #$07                                     ; 2..6: zona morta (fraco ja' saiu no aperto)
|    bcc EdgeBBtn                                 ; 7..20: forte segue armado enquanto segurar
|EdgeAStrong:
|    lda #$01                                     ; soco forte
|    jmp InputSetAttack
|EdgeAWeak:
|    lda #$00                                     ; soco fraco na borda de subida
|    jmp InputSetAttack
|EdgeARel:                                        ; A soltou
|    ldy BtnAHold,x
|    lda #$00
|    sta BtnAHold,x                               ; zera o contador do soco
|    cpy #$15                                     ; >=21 (marcador $FF ou segurou demais): nada
|    bcs EdgeBBtn
|    cpy #$07
|    bcc EdgeBBtn                                ; <7: nada (o fraco ja' saiu no aperto)
|    bcs EdgeAStrong                              ; 7..20: forte uma ultima vez
|EdgeBBtn:                                        ; botao B (bit 6)
|    lda JoyState,x
|    and #$40
|    beq EdgeBRel                                 ; soltou
|    ldy BtnBHold,x
|    iny
|    beq BtnNone                                  ; wrap $FF->0 (marcador de forte): nenhum golpe
|    sty BtnBHold,x
|    cpy #$02                                     ; borda de subida
|    bcc EdgeBWeak                                ; -> chute fraco AGORA
|    cpy #$07                                     ; 2..6: zona morta
|    bcc BtnNone                                  ; 7..20: forte segue armado
|EdgeBStrong:
|    lda #$03                                     ; chute forte
|    jmp InputSetAttack
|EdgeBWeak:
|    lda #$02                                     ; chute fraco na borda de subida
|    jmp InputSetAttack
|EdgeBRel:                                        ; B soltou
|    ldy BtnBHold,x
|    lda #$00
|    sta BtnBHold,x                               ; zera o contador do chute
|    cpy #$15
|    bcs BtnNone
|    cpy #$07
|    bcc BtnNone                                  ; <7: nada
|    bcs EdgeBStrong                              ; 7..20: forte uma ultima vez

# marcador seletivo do despacho de botao (substitui ldy #$15 / sty BtnAHold,x / sty BtnBHold,x)
alt FIX_EDGE_ATTACK 3F:F6C9 6
|    jsr EdgeMarkHold

# rotina do marcador seletivo, no espaco livre do banco (F949)
alt FIX_EDGE_ATTACK 3F:F949 36
|EdgeMarkHold:
|    lda InputAttack,x                           ; 0/1 soco, 2/3 chute ($FF nao chega: bmi em F6BD)
|    cmp #$01
|    beq EdgeMarkStrong
|    cmp #$03
|    beq EdgeMarkStrong
|    cmp #$00
|    beq EdgeMarkA
|    cmp #$02
|    beq EdgeMarkB
|    rts
|EdgeMarkStrong:
|    ldy #$FF                                     ; forte despachado: desarma os dois contadores
|    sty BtnAHold,x                               ; (segurando: wrap do iny; soltando: cpy #$15)
|    sty BtnBHold,x
|    rts
|EdgeMarkA:
|    ldy #$01                                     ; fraco despachado: segue contando (promocao aos 7)
|    sty BtnAHold,x
|    rts
|EdgeMarkB:
|    ldy #$01
|    sty BtnBHold,x
|    rts

# ============================================================================================================
# MODO VERSUS (experimental): jogador 2 humano   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D MODE_VERSUS")
# O motor ja suporta dois humanos: basta FighterIsCpu+1 = 0. No demo nada faz isso (MainLoop fixa 1).
# Com este bloco o P2 e' sempre o controle 2 (nao ha mais adversario CPU) — serve para testar o modo versus.
alt MODE_VERSUS 3F:F868 2
# ============================================================================================================
# DIFICULDADE/VERSUS (FIX_SELECT_VERSUS): START na selecao entra vs mode
# bit $10 de JoyState, banco $37 (SelectInit/EF92)
# Quando START pressionado: P2 humano, bloqueado em Ryu, HUD $P2$

alt FIX_SELECT_VERSUS 37:EF92 3
|    ; verifica START (bit $10) para entrar no modo versus
|    lda JoyState,x
|    and #$10
|    beq START_CHECK_END
|    ; START pressionado: entra modo versus
|    lda #$00
|   sta FighterIsCpu+1  ; P2 = humano (usa MODE_VERSUS alt)
|   sta FighterChar+1   ; P2 bloqueado em Ryu (indice 0)
|   lda #$05
|   sta ScreenMode      ; modo versus
|   jmp ScreenVersus
|;;
# ============================================================================================================




# ============================================================================================================
# DIFICULDADE (FIX_SELECT_DIFFICULTY): SELECT na tela de seleção alterna Fácil/Normal/Difícil
# bit $20 de JoyState, banco $37 (SelectInit/EF92, SelectReadInput/F1CC)
# AiLevel: 2=Fácil, 4=Normal, 7=Difícil, padrão 4
# Lê SELECT em SelectInit/EF92 ao invés de MainLoop/F7A2
# usa ram_0412/0413 (livre) em vez de $B6=RoundStep

alt FIX_SELECT_DIFFICULTY 37:EF92 2
|    ; le bit $20 (SELECT) do JoyState do jogador corrente
|    lda JoyState,x
|    and #$20
|    beq +
|    ; SELECT apertado: alterna AiLevel
|    lda AiLevel,x
|    clc
|    adc #$02
|    cmp #$09
|    bcs ++
|    sta AiLevel,x
|    jmp ++
|++;
|    lda #$04
|    sta AiLevel,x
|++;


# ============================================================================================================
# BANDEIRA DO PAIS DE DESTINO visivel (DEST_FLAG_BLINK) — build canonico
#
# REGRA DE OURO: apos a confirmacao (ram_03B5 = destino), a bandeira do PAIS DO OPONENTE
# (destino da batalha) e' a que deve ficar visível no mapa, nao a do pais sob o cursor.
# Hoje o oponente e' sempre Ryu (Japao), entao ram_03B5 = 0 e a bandeira do Japao e' a que
# aparece. Quando houver oponentes de outros paises, o narrador anuncia o pais
# (CountryVoiceTbl) e a bandeira desse pais fica visível.
#
# Durante a selecao livre (antes da confirmacao) a bandeira do pais sob o cursor continua
# visível (original). Apos a confirmacao, o Japao e' desenhado como sprite extra na paleta 3
# (PaletteBuf+21..23, em $3F1D..$3F1F), na mesma posicao do mapa, e a bandeira do cursor e'
# escondida se o cursor nao estiver no Japão. O NMI da selecao reenvia a paleta ao PPU quando
# suja. Ao fim da selecao (37:EF8F) deixa a bandeira do cursor acesa e remove a copia extra
# do destino antes do fade para a tela VS.

# chama o desenho do destino no lugar da leitura do controle (1 chamada por quadro do laco de selecao)
alt DEST_FLAG_BLINK 37:EFF0 3
|    jsr DestFlagBlink

# depois de desenhar a bandeira do cursor, acrescenta a bandeira do destino. O hook substitui
# "lda D37_F293,x"; a rotina devolve A com o mesmo índice de lutador para o "sta FighterChar" original.
alt DEST_FLAG_BLINK 37:F066 3
|    jsr DestFlagOam

# ao fim da selecao (37:EF8F = jmp SelectFighterIntro) deixa a bandeira do cursor acesa e remove
# a copia extra do destino antes do fade para a tela VS
alt DEST_FLAG_BLINK 37:EF8F 3
|    jmp DestFlagRestore

# rotina da bandeira do destino, no espaco livre do banco $37 (F6A5)
alt DEST_FLAG_BLINK 37:F6A5 C0
|DestFlagBlink:
|    lda zp_D7                   ; P1 confirmou o lutador? (setado em SelectConfirm)
|    beq DestFlagFwd             ; nao confirmou ainda: comportamento normal (bandeira do cursor)
|    lda ram_03B5                ; pais de destino: 0 = Japao (Ryu)
|    cmp #$00
|    bne DestFlagFwd             ; so' o Japao esta' implementado por enquanto
|    ; prepara a paleta 3 com as cores do Japão (sol $16, campo $20)
|    lda #$11
|    sta a:PaletteBuf+21
|    lda #$16
|    sta a:PaletteBuf+22
|    lda #$20
|    sta a:PaletteBuf+23
|    lda #$01
|    sta a:PaletteDirty
|    ; desenha a bandeira do Japão na paleta 3 (visível, sem pisca-pisca)
|    lda #$4E                    ; OAM 6/7 Y do Japao (tiles $8C/$8E)
|    sta OamBuf+24               ; sprite 6 Y
|    sta OamBuf+28               ; sprite 7 Y
|    lda #$8C                    ; tile $8C
|    sta OamBuf+25
|    lda #$8E                    ; tile $8E
|    sta OamBuf+29
|    lda #$03                    ; paleta 3, exclusiva da bandeira do destino
|    sta OamBuf+26
|    sta OamBuf+30
|    lda #$80                    ; posicao X do Japao no mapa
|    sta OamBuf+27
|    lda #$88                    ; posicao X+8 do Japao no mapa
|    sta OamBuf+31
|DestFlagFwd:
|    jmp SelectReadInput
|
|DestFlagOam:
|    ldx zp_E9
|    cpx #$00                    ; no Japao, nao esconde a copia normal (paleta 2)
|    bne DestFlagDraw
|    lda #$FE
|    sta OamBuf+16               ; sprite 4 do pais do cursor
|    sta OamBuf+20               ; sprite 5 do pais do cursor
|DestFlagDraw:
|    ldx zp_E9
|    lda D37_F293,x              ; devolve o índice original para "sta FighterChar"
|    rts
|
|DestFlagRestore:
|    lda #$1A                    ; restaura a paleta 3 original da tela
|    sta a:PaletteBuf+21
|    lda #$27
|    sta a:PaletteBuf+22
|    lda #$21
|    sta a:PaletteBuf+23
|    lda #$FE                    ; remove a copia extra do destino
|    sta OamBuf+24
|    sta OamBuf+28
|    lda #$01
|    sta a:PaletteDirty
|    jmp SelectFighterIntro


# ============================================================================================================
