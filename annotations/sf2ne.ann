# ============================================================================================================
# BANCOS DE ESTADOS DOS LUTADORES (formato em docs/ARQUITETURA.md, secao 4.2)
# statebank <banco> frames=<banco dos frames> from=<inicio> to=<fim>
# Completa, pela estrutura dos registros, os ponteiros dos estados que nenhum trace visitou.
# ============================================================================================================
statebank 01 frames=00 from=A0B0 to=B1C6

# ============================================================================================================
# PONTEIROS CONFIRMADOS A MAO (o trace nao passou por estes trechos; achados com tools/ptr_candidates.py)
# ============================================================================================================
# Candidatos do ptr_candidates.py ja revisados e que NAO sao ponteiros (sao coordenadas, rolagem ou enderecos do PPU):
#   37:EF58/EF5D ($E0F8 -> ScrollX/ScrollY)   37:F576/F57A ($FF10)          3B:E3AE/E3A9 ($8000 -> camera)
#   3B:E5D7/E5DC ($FF32)                      3B:E622/E61D ($C6C5 -> HUD)   3B:EC10/EC14 ($90E0 -> posicao x,y)
#   3B:ECAB/ECB0 e 3B:ECCF/ECD4 (endereco de nametable)   3B:F784/F788 ($805C -> posicao x,y)   3F:F85C/F860 ($FFFF)
# roteiro de IA do Ryu passado em A/Y para AiStartScript
ptr 00:9036 lo 00:8F16
ptr 00:9038 hi 00:8F16
# mesmo ponteiro de 3B:E188, noutro caminho
ptr 3B:E158 lo 3C:83B6
ptr 3B:E15C hi 3C:83B6
# metasprite de texto de fim de round (ramo nunca executado nos traces), irmao de 3B:F88F -> 20:84A1
ptr 3B:F8A2 lo 20:848B
ptr 3B:F8A6 hi 20:848B

# ============================================================================================================
# CORRECAO OPCIONAL: travamento no soft reset  (make fixed)   — detalhes em docs/BUGS.md
# O codigo de RESET so existe no banco $3F, mas o MMC5 nao e' reiniciado pelo botao RESET do console: se o reset
# acontece com o banco $37 ou $3B em $E000, o vetor aponta para $FF9F cheio de $FF e o jogo trava.
# A correcao poe o MESMO trecho de 13 bytes no espaco livre $FC6D dos tres bancos e aponta o vetor de RESET
# para ele: ele mapeia o banco $3F e pula para o reset original.
alt FIX_SOFT_RESET 37:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS                         ; desliga o IRQ de scanline que pode ter ficado armado
|    lda #$BF
|    sta MMC5_PRG_E000                           ; banco $3F em $E000 (a proxima instrucao ja vem dele)
|    jmp $FF9F                                   ; Reset original (so existe no banco $3F)
alt FIX_SOFT_RESET 3B:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS
|    lda #$BF
|    sta MMC5_PRG_E000
|    jmp $FF9F
alt FIX_SOFT_RESET 3F:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS
|    lda #$BF
|    sta MMC5_PRG_E000
|    jmp $FF9F
alt FIX_SOFT_RESET 37:FFFC 2
|    .word ResetStub
alt FIX_SOFT_RESET 3B:FFFC 2
|    .word ResetStub
alt FIX_SOFT_RESET 3F:FFFC 2
|    .word ResetStub

# ============================================================================================================
# AJUSTE EXPERIMENTAL: golpe forte dispara UMA vez   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D FIX_HEAVY_ONCE")
# No original, segurar A/B emite o golpe forte a cada quadro do 7o ao 20o e outra vez ao soltar (ver docs/BUGS.md).
# Aqui ele e' emitido so no quadro em que o contador chega a 7, e soltar depois disso nao emite nada.
# Muda a jogabilidade: teste antes de adotar.
alt FIX_HEAVY_ONCE 3F:E9AD 2
|    bne L3F_E9CB                                ; era bcc: so quando o contador e' exatamente 7
alt FIX_HEAVY_ONCE 3F:E9C6 2
|    lda #$FF                                    ; era lda #$01: soltar depois de 7 quadros nao repete o golpe
alt FIX_HEAVY_ONCE 3F:E9DE 2
|    bne L3F_E9FC
alt FIX_HEAVY_ONCE 3F:E9F7 2
|    lda #$FF

# ============================================================================================================
# MODO VERSUS (experimental): jogador 2 humano   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D MODE_VERSUS")
# O motor ja suporta dois humanos: basta FighterIsCpu+1 = 0. No demo nada faz isso (MainLoop fixa 1).
# Com este bloco o P2 e' sempre o controle 2 (nao ha mais adversario CPU) — serve para testar o modo versus.
alt MODE_VERSUS 3F:F868 2
|    lda #$00                                    ; era lda #$01 (P2 = CPU)
