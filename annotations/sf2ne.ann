# ============================================================================================================
# OPTIONAL FIX: soft reset freeze  (make fixed)   — details in docs/BUGS.md
# RESET code exists only in bank $3F, but MMC5 is not reset by console RESET button: if reset
# happens with bank $37 or $3B at $E000, vector points to $FF9F full of $FF and game freezes.
# The fix puts the SAME 13-byte chunk in free space $FC6D of all three banks and points RESET vector
# to it: it maps bank $3F and jumps to original reset.
alt FIX_SOFT_RESET 37:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS                         ; turns off scanline IRQ that may have been left armed
|    lda #$BF
|    sta MMC5_PRG_E000                           ; bank $3F at $E000 (next instruction already comes from it)
|    jmp $FF9F                                   ; original Reset (exists only in bank $3F)
alt FIX_SOFT_RESET 3B:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS
|    lda #$BF
|    sta MMC5_PRG_E000
|    jmp $FF9F
alt FIX_SOFT_RESET 3F:FC6D F
|ResetStub:
|    lda #$00
|    sta MMC5_IRQ_STATUS
|    lda #$BF
|    sta MMC5_PRG_E000
|    jmp $FF9F
alt FIX_SOFT_RESET 37:FFFC 2
|    .word ResetStub
alt FIX_SOFT_RESET 3B:FFFC 2
|    .word ResetStub
alt FIX_SOFT_RESET 3F:FFFC 2
|    .word ResetStub

# ============================================================================================================
# EXPERIMENTAL ADJUSTMENT: strong hit fires ONCE   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D FIX_HEAVY_ONCE")
# In original, holding A/B emits strong hit every frame from 7th to 20th and again on release (see docs/BUGS.md).
# Here it is emitted only on the frame counter reaches 7, and releasing after that emits nothing.
# Changes gameplay: test before adopting.
# NOTE: the 4 anchors below fall inside the block rewritten by FIX_EDGE_ATTACK (E99A-E9FB): they are emitted
# nested in its .else branch, so they keep working alone as before. With FIX_EDGE_ATTACK on
# they are subsumed: non-repetition of strong now comes from EdgeMarkHold's $FF marker. Combining both is harmless.
alt FIX_HEAVY_ONCE 3F:E9AD 2
|    bne BtnBCheck                               ; was bcc: only when counter is exactly 7
alt FIX_HEAVY_ONCE 3F:E9C6 2
|    lda #$FF                                    ; was lda #$01: releasing after 7 frames does not repeat hit
alt FIX_HEAVY_ONCE 3F:E9DE 2
|    bne BtnNone
alt FIX_HEAVY_ONCE 3F:E9F7 2
|    lda #$FF

# ============================================================================================================
# ADJUSTMENT: hit on rising edge + weak->strong promotion   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D FIX_EDGE_ATTACK")
# Original problem (docs/BUGS.md item 2): hit only comes out when button is RELEASED (weak) or repeats
# from 7th to 20th frame (strong) — every hit comes out delayed and strong "machine-guns".
# Here: WEAK comes out on the frame button is pressed (rising edge: counter==1); holding,
# the counter keeps counting and on the 7th frame STRONG takes over (promotion — engine already decides
# whether fighter state allows canceling weak animation). Releasing before 7 frames emits nothing (weak
# already came out on press); releasing between 7 and 20 emits strong one last time, as in original.
#
# Anti-repetition (heart of adjustment): InputDispatch marker (F6C9) was blind — wrote $15 to BOTH
# counters on any button dispatch, including weak, which would kill promotion. Now it is
# selective (EdgeMarkHold, in free space): strong dispatched -> $FF in both counters (on held path
# iny wraps to 0 and disarms; on release cpy #$15 ignores); weak dispatched -> $01 in its own counter
# only (counts from there; other button not affected).
#
# The A+B section of InputButtons (E99A-E9FB, $62 = 98 bytes) is rewritten entirely in one block; the 4
# FIX_HEAVY_ONCE anchors fall inside it (see note above). The weak/strong emitter tail-calls
# InputSetAttack (sta InputAttack,x; rts) same as original, skipping other button processing.
# Conscious differences vs original: holding beyond 20 frames strong stays armed (original
# gave up — here it comes out when state allows, which is requested behavior); after ~256 frames
# holding counter wraps and button re-edges (weak) — extreme case, original also had
# a wrap there (beq of $FF->0).
alt FIX_EDGE_ATTACK 3F:E99A 62
|InputButtons:
|    lda JoyState,x                              ; button A (bit 7): held?
|    bpl EdgeARel                                ; released -> release logic
|    ldy BtnAHold,x
|    iny
|    beq EdgeBBtn                                ; wrap $FF->0 (strong marker): ignores
|    sty BtnAHold,x
|    cpy #$02                                     ; rising edge: counter==1
|    bcc EdgeAWeak                                ; -> weak punch NOW
|    cpy #$07                                     ; 2..6: dead zone (weak already came out on press)
|    bcc EdgeBBtn                                 ; 7..20: strong stays armed while holding
|EdgeAStrong:
|    lda #$01                                     ; strong punch
|    jmp InputSetAttack
|EdgeAWeak:
|    lda #$00                                     ; weak punch on rising edge
|    jmp InputSetAttack
|EdgeARel:                                        ; A released
|    ldy BtnAHold,x
|    lda #$00
|    sta BtnAHold,x                               ; zeroes punch counter
|    cpy #$15                                     ; >=21 ($FF marker or held too long): nothing
|    bcs EdgeBBtn
|    cpy #$07
|    bcc EdgeBBtn                                ; <7: nothing (weak already came out on press)
|    bcs EdgeAStrong                              ; 7..20: strong one last time
|EdgeBBtn:                                        ; button B (bit 6)
|    lda JoyState,x
|    and #$40
|    beq EdgeBRel                                 ; released
|    ldy BtnBHold,x
|    iny
|    beq BtnNone                                  ; wrap $FF->0 (strong marker): no hit
|    sty BtnBHold,x
|    cpy #$02                                     ; rising edge
|    bcc EdgeBWeak                                ; -> weak kick NOW
|    cpy #$07                                     ; 2..6: dead zone
|    bcc BtnNone                                  ; 7..20: strong stays armed
|EdgeBStrong:
|    lda #$03                                     ; strong kick
|    jmp InputSetAttack
|EdgeBWeak:
|    lda #$02                                     ; weak kick on rising edge
|    jmp InputSetAttack
|EdgeBRel:                                        ; B released
|    ldy BtnBHold,x
|    lda #$00
|    sta BtnBHold,x                               ; zeroes kick counter
|    cpy #$15
|    bcs BtnNone
|    cpy #$07
|    bcc BtnNone                                  ; <7: nothing
|    bcs EdgeBStrong                              ; 7..20: strong one last time

# button dispatch selective marker (replaces ldy #$15 / sty BtnAHold,x / sty BtnBHold,x)
alt FIX_EDGE_ATTACK 3F:F6C9 6
|    jsr EdgeMarkHold

# selective marker routine, in bank free space (F949)
alt FIX_EDGE_ATTACK 3F:F949 36
|EdgeMarkHold:
|    lda InputAttack,x                           ; 0/1 punch, 2/3 kick ($FF doesn't arrive: bmi at F6BD)
|    cmp #$01
|    beq EdgeMarkStrong
|    cmp #$03
|    beq EdgeMarkStrong
|    cmp #$00
|    beq EdgeMarkA
|    cmp #$02
|    beq EdgeMarkB
|    rts
|EdgeMarkStrong:
|    ldy #$FF                                     ; strong dispatched: disarms both counters
|    sty BtnAHold,x                               ; (holding: iny wrap; releasing: cpy #$15)
|    sty BtnBHold,x
|    rts
|EdgeMarkA:
|    ldy #$01                                     ; weak dispatched: keeps counting (promotion at 7)
|    sty BtnAHold,x
|    rts
|EdgeMarkB:
|    ldy #$01
|    sty BtnBHold,x
|    rts

# ============================================================================================================
# VERSUS MODE (experimental): player 2 human   (make fixed FIXDEFS="-D FIX_SOFT_RESET -D MODE_VERSUS")
# Engine already supports two humans: just FighterIsCpu+1 = 0. In demo nothing does this (MainLoop fixes 1).
# With this block P2 is always controller 2 (no more CPU opponent) — serves to test versus mode.
alt MODE_VERSUS 3F:F868 2
# ============================================================================================================
# DIFFICULTY/VERSUS (FIX_SELECT_VERSUS): START on selection enters vs mode
# bit $10 of JoyState, bank $37 (SelectInit/EF92)
# When START pressed: P2 human, locked to Ryu, HUD $P2$

alt FIX_SELECT_VERSUS 37:EF92 3
|    ; checks START (bit $10) to enter versus mode
|    lda JoyState,x
|    and #$10
|    beq START_CHECK_END
|    ; START pressed: enters versus mode
|    lda #$00
|   sta FighterIsCpu+1  ; P2 = human (uses MODE_VERSUS alt)
|   sta FighterChar+1   ; P2 locked to Ryu (index 0)
|   lda #$05
|   sta ScreenMode      ; versus mode
|   jmp ScreenVersus
|;;
# ============================================================================================================




# ============================================================================================================
# DIFFICULTY (FIX_SELECT_DIFFICULTY): SELECT on selection screen toggles Easy/Normal/Hard
# bit $20 of JoyState, bank $37 (SelectInit/EF92, SelectReadInput/F1CC)
# AiLevel: 2=Easy, 4=Normal, 7=Hard, default 4
# Reads SELECT in SelectInit/EF92 instead of MainLoop/F7A2
# uses ram_0412/0413 (free) instead of $B6=RoundStep

alt FIX_SELECT_DIFFICULTY 37:EF92 2
|    ; reads bit $20 (SELECT) of current player's JoyState
|    lda JoyState,x
|    and #$20
|    beq +
|    ; SELECT pressed: toggles AiLevel
|    lda AiLevel,x
|    clc
|    adc #$02
|    cmp #$09
|    bcs ++
|    sta AiLevel,x
|    jmp ++
|++;
|    lda #$04
|    sta AiLevel,x
|++;


# ============================================================================================================
# DESTINATION COUNTRY FLAG visible (DEST_FLAG_BLINK) — canonical build
#
# GOLDEN RULE: after confirmation (ram_03B5 = destination), the OPPONENT COUNTRY's flag
# (battle destination) is the one that should be visible on the map, not the country under cursor.
# Today opponent is always Ryu (Japan), so ram_03B5 = 0 and Japan flag is the one
# that appears. When there are opponents from other countries, narrator announces country
# (CountryVoiceTbl) and that country's flag becomes visible.
#
# During free selection (before confirmation) flag of country under cursor remains
# visible (original). After confirmation, Japan is drawn as extra sprite on palette 3
# (PaletteBuf+21..23, at $3F1D..$3F1F), at same map position, and cursor flag is
# hidden if cursor is not on Japan. Selection NMI re-sends palette to PPU when dirty.
# At end of selection (37:EF8F) leaves cursor flag lit and removes extra destination
# copy before fade to VS screen.

# calls destination drawing instead of controller read (1 call per selection loop frame)
alt DEST_FLAG_BLINK 37:EFF0 3
|    jsr DestFlagBlink

# after drawing cursor flag, adds destination flag. Hook replaces
# "lda SelectCursorFighterTbl,x"; routine returns A with same fighter index for original "sta FighterChar".
alt DEST_FLAG_BLINK 37:F066 3
|    jsr DestFlagOam

# at end of selection (37:EF8F = jmp SelectFighterIntro) leaves cursor flag lit and removes
# extra destination copy before fade to VS screen
alt DEST_FLAG_BLINK 37:EF8F 3
|    jmp DestFlagRestore

# destination flag routine, in bank $37 free space (F6A5)
alt DEST_FLAG_BLINK 37:F6A5 C0
|DestFlagBlink:
|    lda zp_D7                   ; P1 confirmed fighter? (set in SelectConfirm)
|    beq DestFlagFwd             ; not confirmed yet: normal behavior (cursor flag)
|    lda ram_03B5                ; destination country: 0 = Japan (Ryu)
|    cmp #$00
|    bne DestFlagFwd             ; only Japan is implemented for now
|    ; prepares palette 3 with Japan colors (sun $16, field $20)
|    lda #$11
|    sta a:PaletteBuf+21
|    lda #$16
|    sta a:PaletteBuf+22
|    lda #$20
|    sta a:PaletteBuf+23
|    lda #$01
|    sta a:PaletteDirty
|    ; draws Japan flag on palette 3 (visible, no blinking)
|    lda #$4E                    ; OAM 6/7 Y of Japan (tiles $8C/$8E)
|    sta OamBuf+24               ; sprite 6 Y
|    sta OamBuf+28               ; sprite 7 Y
|    lda #$8C                    ; tile $8C
|    sta OamBuf+25
|    lda #$8E                    ; tile $8E
|    sta OamBuf+29
|    lda #$03                    ; palette 3, exclusive to destination flag
|    sta OamBuf+26
|    sta OamBuf+30
|    lda #$80                    ; Japan X position on map
|    sta OamBuf+27
|    lda #$88                    ; Japan X+8 position on map
|    sta OamBuf+31
|DestFlagFwd:
|    jmp SelectReadInput
|
|DestFlagOam:
|    ldx zp_E9
|    cpx #$00                    ; in Japan, does not hide normal copy (palette 2)
|    bne DestFlagDraw
|    lda #$FE
|    sta OamBuf+16               ; sprite 4 of cursor country
|    sta OamBuf+20               ; sprite 5 of cursor country
|DestFlagDraw:
|    ldx zp_E9
|    lda SelectCursorFighterTbl,x; returns original index for "sta FighterChar"
|    rts
|
|DestFlagRestore:
|    lda #$1A                    ; restores original screen palette 3
|    sta a:PaletteBuf+21
|    lda #$27
|    sta a:PaletteBuf+22
|    lda #$21
|    sta a:PaletteBuf+23
|    lda #$FE                    ; removes extra destination copy
|    sta OamBuf+24
|    sta OamBuf+28
|    lda #$01
|    sta a:PaletteDirty
|    jmp SelectFighterIntro


